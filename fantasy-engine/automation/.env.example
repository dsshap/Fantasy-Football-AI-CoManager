# ESPN Authentication (Required)
# Get these from browser DevTools while logged into fantasy.espn.com
ESPN_S2=your_espn_s2_cookie_here
ESPN_SWID={your-swid-uuid-here}

# League Configuration (At least one required)
# League 1 - Main League
LEAGUE_1_ID=21366365
LEAGUE_1_TEAM_ID=7
LEAGUE_1_NAME=Main League

# League 2 - Secondary League (Optional)
LEAGUE_2_ID=your_league_2_id
LEAGUE_2_TEAM_ID=your_team_2_id
LEAGUE_2_NAME=Secondary League

# LLM Provider Keys (Optional for testing ESPN)
GEMINI_API_KEY=your_gemini_key_here
# CLAUDE_API_KEY=your_claude_key_here
# OPENAI_API_KEY=your_openai_key_here
# PERPLEXITY_API_KEY=your_perplexity_key_here

# Generic OpenAI-compatible provider example (e.g. Ollama Cloud)
# OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_key_here
# OPENAI_COMPATIBLE_BASE_URL=https://ollama.com/v1
# OPENAI_COMPATIBLE_MODEL=kimi-k2.6
# Set false to allow LLM web_search tool calls when the provider supports them.
# OPENAI_COMPATIBLE_DISABLE_TOOLS=false

# Live web search (optional)
# SERPER_API_KEY=your_serper_key_here
# MAX_WEB_SEARCHES=5
# MAX_WEB_SEARCH_RESULT_CHARS=3000
# LLM_MAX_OUTPUT_TOKENS=12000

# Other Settings (Optional)
PRIMARY_LLM_PROVIDER=gemini
DAILY_COST_LIMIT=3.00
WEEKLY_COST_LIMIT=15.00
MONTHLY_COST_LIMIT=50.00